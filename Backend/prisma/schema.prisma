generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum loginType {
  google
  github
  email
}

enum orderStatus {
  pending
  completed
  failed
}

enum Role {
  USER
  ADMIN
}

model User {
  id           String    @id @default(uuid())
  googleId     String?   @unique
  githubId     String?   @unique
  name         String
  email        String    @unique
  passwordHash String?
  picture      String?
  role         Role      @default(USER)
  loginType    loginType @default(google)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  sessions         Session[]
  projects         Project[]
  userSubscription UserSubscription?
  orders           Order[]
  adminLogs        AdminLog[]
  searchHistory    SearchHistory[]

  @@index([email])
  @@index([role])
  @@index([createdAt])
  @@map("users")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Project {
  id                 String   @id @default(uuid())
  projectName        String
  productName        String
  productDescription String?
  userPrompt         String?
  productImage       String
  modelImage         String
  generatedImage     String
  generatedVideo     String
  aspectRatio        String   @default("9:16")
  isPublic           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model Subscription {
  id        String   @id @default(uuid())
  name      String   @unique
  price     Int
  credits   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userSubscriptions UserSubscription[]
  orders            Order[]

  @@map("subscriptions")
}

model UserSubscription {
  id             String   @id @default(uuid())
  credits        Int
  userId         String   @unique
  subscriptionId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("user_subscriptions")
}

model Order {
  id             String      @id @default(uuid())
  userId         String
  subscriptionId String
  amount         Int
  status         orderStatus @default(pending)
  transactionId  String?     @unique
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([transactionId])
  @@map("orders")
}

model AdminLog {
  id        String   @id @default(uuid())
  adminId   String
  action    String
  targetId  String?
  details   Json?
  createdAt DateTime @default(now())

  admin User @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([createdAt])
  @@map("admin_logs")
}

model SearchHistory {
  id        String   @id @default(uuid())
  userId    String
  query     String
  type      String
  filters   Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("search_history")
}
